name = "moonbitstack/moonvec"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonvec"

license = "Apache-2.0"

keywords = [
  "numpy",
  "ndarray",
  "array",
  "broadcasting",
  "broadcast",
  "linear-algebra",
  "linalg",
  "matrix",
  "matrix-multiplication",
  "matmul",
  "tensor",
  "dtype",
  "ufunc",
  "universal-function",
  "reduction",
  "slice",
  "stride",
  "view",
  "reshape",
  "transpose",
  "solve",
  "inverse",
  "determinant",
  "cholesky",
  "qr",
  "svd",
  "eigenvalue",
  "least-squares",
  "norm",
  "kron",
  "complex",
  "half-precision",
  "float16",
  "numerics",
  "scientific-computing",
  "signal-processing",
  "machine-learning",
  "simd",
  "vectorization",
  "cute",
  "layout",
]

description = "N-dimensional arrays with dtypes, broadcasting, universal functions and linear algebra."

source = "src"

import {
  "moonbitstack/moonmath@0.2.1",
}
