    #|out float64 8 000000000080f4bf0000000000e01940000000000000e63f00000000004013c0000000000000e1bf0000000000001c400000000000001840000000000080f8bf
    #|end
    #|case cast/complex128
    #|op cast:complex128
    #|in float64 8 000000000000c2bf00000000007014c000000000006000c00000000000b011c000000000001017c00000000000e009c00000000000e019c0000000000000eb3f
    #|out complex128 8 000000000000c2bf000000000000000000000000007014c0000000000000000000000000006000c000000000000000000000000000b011c0000000000000000000000000001017c000000000000000000000000000e009c000000000000000000000000000e019c00000000000000000000000000000eb3f0000000000000000
    #|end
    #|case cast/from-complex128
    #|op cast:float64
    #|in complex128 8 0000000000c01d400000000000c00dc0000000000000f73f00000000002016400000000000201b40000000000000ea3f000000000080f0bf0000000000c021400000000000e01440000000000080204000000000006010400000000000c01dc000000000000012c00000000000c01a400000000000401cc00000000000a02140
    #|out float64 8 0000000000c01d40000000000000f73f0000000000201b40000000000080f0bf0000000000e01440000000000060104000000000000012c00000000000401cc0
    #|end
  text
}

///|
/// Every generated vector line, in the order the generator wrote them.
fn vector_text() -> String {
  let chunks : Array[() -> String] = [
    vector_lines_01, vector_lines_02, vector_lines_03, vector_lines_04, vector_lines_05,
    vector_lines_06, vector_lines_07, vector_lines_08, vector_lines_09, vector_lines_10,
    vector_lines_11, vector_lines_12, vector_lines_13, vector_lines_14, vector_lines_15,
    vector_lines_16, vector_lines_17, vector_lines_18, vector_lines_19, vector_lines_20,
    vector_lines_21, vector_lines_22, vector_lines_23, vector_lines_24, vector_lines_25,
    vector_lines_26, vector_lines_27, vector_lines_28, vector_lines_29, vector_lines_30,
    vector_lines_31, vector_lines_32, vector_lines_33, vector_lines_34, vector_lines_35,
    vector_lines_36, vector_lines_37, vector_lines_38, vector_lines_39, vector_lines_40,
    vector_lines_41, vector_lines_42, vector_lines_43, vector_lines_44, vector_lines_45,
    vector_lines_46, vector_lines_47, vector_lines_48, vector_lines_49, vector_lines_50,
    vector_lines_51, vector_lines_52, vector_lines_53, vector_lines_54, vector_lines_55,
    vector_lines_56,
  ]
  let parts : Array[String] = []
  for chunk in chunks {
    parts.push(chunk())
  }
  parts.join("\n")
}
